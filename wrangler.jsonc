{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codex-pic",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": [],

  // Static assets configuration - serve from public/ directory
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Route /api/* to the Worker, serve other paths as static files
    "run_worker_first": ["/api/*", "/case-image/*"]
  },

  // Custom domain for pic.lipeng.fun
  "routes": [
    { "pattern": "pic.lipeng.fun", "custom_domain": true }
  ],

  // Enable workers.dev fallback URL
  "workers_dev": true,

  // Observability for production
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
